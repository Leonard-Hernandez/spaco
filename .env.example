# Copy to .env and fill in. Never commit .env.

# Public origin of the gateway (http://localhost:8093 locally, the tunnel/ingress URL in a demo)
PUBLIC_URL=http://localhost:8093
GATEWAY_PORT=8093

# Own role and database in the shared Postgres (../platform, see README "Platform")
USER_DB=spaco
PASSWORD_DB=change-me

# Google email of the spa owner (first panel access)
BOOTSTRAP_OWNER_EMAIL=
